node_modules/
dist/
logs/
*.log

# env (example のみ許可)
.env
.env.*
!.env.example

# 自 DB スナップショット (schema/migrations は追跡, データは追跡しない)
/data/*.db
/data/*.db-*
!/data/.gitkeep

# Anatomia のローカル状態 (事業ドメイン定義の正本は spec/domains/)。
# 例外は layers.json — これは解析キャッシュではなく、 リポジトリが持つプログラムドメイン
# (層) の宣言。 追跡しないと Revisor の二層ゲートから層が見えず、 変更アンカーが全部
# 「未分類」になる。 なお `.anatomia/` とディレクトリごと除外する形にはしないこと —
# git は除外ディレクトリ内のファイルを `!` で再包含できず、 layers.json をコミットできなくなる。
.anatomia/*
!.anatomia/layers.json
