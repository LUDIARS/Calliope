# Calliope 環境変数 (コピーして .env に)。秘密はコミットしない。
# ポート正本は Excubitor catalog。8891 は提案値であり、catalog 登録後はそちらが正。
CALLIOPE_PORT=8891

# 自 DB (計画成果物のみ)
CALLIOPE_DB_PATH=./data/calliope.db

# 並列 AI 容量 (スケジューラのレーン数)。将来 Concordia 実データ結線。
CALLIOPE_AGENT_LANES=3

# Calliope 自身の /api/* を保護。未設定時は開発用に認証をスキップし起動警告。
CALLIOPE_SERVICE_TOKEN=

# ── 上流サービス (バインド先) ────────────────────────────────
# Actio: タスク/目標/PM分析の正本
ACTIO_BASE_URL=http://localhost:3000
ACTIO_TOKEN=
# Schedula: 予定/カレンダー/freeBusy の正本
SCHEDULA_BASE_URL=http://localhost:3300
SCHEDULA_TOKEN=
# Memoria: roadmap(優先度) / goal_eval / agent_runs(velocity元) を read-only
MEMORIA_BASE_URL=http://localhost:5180
MEMORIA_TOKEN=

# ── 通知 (任意) ──────────────────────────────────────────────
# Concordia chat / Nuntius へ計画・リスケ提案を通知
CONCORDIA_BASE_URL=http://localhost:11111
NUNTIUS_BASE_URL=http://localhost:3100
NUNTIUS_TOKEN=

# ── LLM (見積り推定 EstimationService 用) ────────────────────
CALLIOPE_CLAUDE_BIN=claude
# off で LLM 段を明示スキップ（結果の skipped_llm / unresolved に記録）
CALLIOPE_LLM_ESTIMATION=on
CALLIOPE_DAILY_ORCHESTRATION=on
CALLIOPE_CALENDAR_AUTO_WRITE=off
CALLIOPE_WEEKLY_RETROSPECTIVE=on
